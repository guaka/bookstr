{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "moduleDetection": "force"
  },
  "include": [
    "src/**/*.ts",
    "tests/types/**/*.ts",
    "scripts/**/*.cts",
    "tests/unit/*.test.ts",
    "tests/e2e/*.spec.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
