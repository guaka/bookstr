{
  "name": "bookstr-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "libstr Electron desktop shell",
  "desktopName": "app.bookstr.desktop.desktop",
  "homepage": "https://github.com/guaka/bookstr",
  "author": {
    "name": "libstr",
    "email": "support@bookstr.dev"
  },
  "main": "main.js",
  "scripts": {
    "check:reader-assets": "node ../shared/reader/generate-web-assets.mjs --check",
    "prepack": "npm run check:reader-assets",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "predist": "npm run check:reader-assets",
    "dist": "electron-builder",
    "predist:linux": "npm run check:reader-assets",
    "dist:linux": "electron-builder --linux",
    "predist:win": "npm run check:reader-assets",
    "dist:win": "electron-builder --win",
    "predist:mac": "npm run check:reader-assets",
    "dist:mac": "electron-builder --mac",
    "predist:all": "npm run check:reader-assets",
    "dist:all": "npm run dist:linux && npm run dist:win && npm run dist:mac",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --experimental-test-coverage --test-coverage-exclude='**/*.test.js' --test-coverage-exclude='**/*.test.mjs' --test tests/unit/*.test.js ../shared/catalog/source-registry.test.mjs ../shared/contracts/device-transfer-v1.test.mjs ../shared/torrent/metadata.test.mjs ../web/tests/book-rights-v2-contract.test.mjs ../web/tests/desktop-progress.test.mjs ../web/tests/reader-speech.test.mjs ../web/tests/reader-typography.test.mjs ../web/tests/speech-settings.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-exclude='**/*.test.js' --test-coverage-exclude='**/*.test.mjs' --test --test-reporter=tap tests/unit/*.test.js ../shared/catalog/source-registry.test.mjs ../shared/contracts/device-transfer-v1.test.mjs ../shared/torrent/metadata.test.mjs ../web/tests/book-rights-v2-contract.test.mjs ../web/tests/desktop-progress.test.mjs ../web/tests/reader-speech.test.mjs ../web/tests/reader-typography.test.mjs ../web/tests/speech-settings.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:docker": "docker build --file Dockerfile.test --tag bookstr-electron-tests .. && docker run --rm --init --ipc=host bookstr-electron-tests",
    "test:e2e:smoke": "playwright test tests/e2e/desktop.smoke.spec.js",
    "test:e2e:reader": "playwright test tests/e2e/desktop.reader.spec.js",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.bookstr.desktop",
    "productName": "libstr",
    "icon": "assets/icon-macos.png",
    "files": [
      "../web/**/*",
      "assets/icon-macos.png",
      "blossom-proxy.js",
      "catalog-proxy.js",
      "dictionary-proxy.js",
      "webtorrent-bridge.js",
      "library-store.js",
      "main.js",
      "preload.js",
      "security-policy.js",
      "speech-model-store.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "assets/icon-macos.png",
      "artifactName": "libstr-desktop-${version}-${os}-${arch}.dmg",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon-macos.png",
      "artifactName": "libstr-desktop-${version}-setup-${arch}.exe",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon-macos.png",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "app.bookstr.desktop"
        }
      },
      "artifactName": "libstr-desktop-${version}-${arch}.AppImage",
      "category": "Office",
      "maintainer": "libstr <support@bookstr.dev>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "nostr-tools": "^2.25.0",
    "qrcode": "^1.5.4",
    "webtorrent": "^3.0.21"
  }
}
