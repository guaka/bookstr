{
  "name": "bookstr-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "libstr Electron desktop shell",
  "desktopName": "app.bookstr.desktop.desktop",
  "homepage": "https://github.com/guaka/bookstr",
  "author": {
    "name": "libstr",
    "email": "support@bookstr.dev"
  },
  "main": "main.js",
  "scripts": {
    "check:reader-assets": "node ../shared/reader/generate-web-assets.mjs --check",
    "build:kindle-mtp": "node native/build-kindle-mtp.js",
    "prepack": "pnpm run check:reader-assets && pnpm run build:kindle-mtp",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "predist": "pnpm run check:reader-assets && pnpm run build:kindle-mtp",
    "dist": "electron-builder",
    "predist:linux": "pnpm run check:reader-assets && pnpm run build:kindle-mtp",
    "dist:linux": "electron-builder --linux",
    "predist:win": "pnpm run check:reader-assets && pnpm run build:kindle-mtp",
    "dist:win": "electron-builder --win",
    "predist:mac": "pnpm run check:reader-assets && pnpm run build:kindle-mtp",
    "dist:mac": "electron-builder --mac",
    "predist:all": "pnpm run check:reader-assets && pnpm run build:kindle-mtp",
    "dist:all": "pnpm run dist:linux && pnpm run dist:win && pnpm run dist:mac",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:coverage:ci": "NODE_OPTIONS='--test-coverage-exclude=acquisition-manager.js --test-coverage-exclude=library-store.js --test-coverage-exclude=library-import.js --test-coverage-exclude=webtorrent-bridge.js --test-coverage-exclude=device-pairing.js --test-coverage-exclude=../web/vendor/nostr-tools.js --test-coverage-exclude=../web/jszip.min.js --test-coverage-exclude=../shared/catalog/acquisition.mjs --test-coverage-exclude=../shared/catalog/source-registry.mjs --test-coverage-exclude=../shared/contracts/device-pairing-v1.mjs --test-coverage-exclude=../shared/contracts/device-pairing-nip17.mjs --test-coverage-exclude=../shared/contracts/device-transfer-v1.mjs --test-coverage-exclude=../shared/rights/rights.mjs --test-coverage-exclude=../shared/torrent/metadata.mjs --test-coverage-exclude=tests/unit/acquisition-manager.test.js --test-coverage-exclude=tests/unit/device-pairing.test.js --test-coverage-exclude=tests/unit/library-import.test.js --test-coverage-exclude=tests/unit/library-store.test.js --test-coverage-exclude=tests/unit/webtorrent-bridge.test.js --test-coverage-exclude=../shared/catalog/acquisition.test.mjs --test-coverage-exclude=../shared/catalog/source-registry.test.mjs --test-coverage-exclude=../shared/contracts/device-pairing-v1.test.mjs --test-coverage-exclude=../shared/contracts/device-pairing-nip17.test.mjs --test-coverage-exclude=../shared/contracts/device-transfer-v1.test.mjs --test-coverage-exclude=../shared/torrent/metadata.test.mjs --test-coverage-exclude=../web/tests/book-rights-v2-contract.test.mjs --test-coverage-exclude=../web/tests/desktop-progress.test.mjs --test-coverage-exclude=../web/tests/device-pairing.test.mjs --test-coverage-exclude=../web/tests/reader-speech.test.mjs --test-coverage-exclude=../web/tests/reader-typography.test.mjs --test-coverage-exclude=../web/tests/speech-settings.test.mjs --test-coverage-exclude=../web/tests/webtorrent-transfer.test.mjs' pnpm run test:coverage",
    "test:unit": "node --max-old-space-size=768 --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude='**/*.test.js' --test-coverage-exclude='**/*.test.mjs' --test tests/unit/*.test.js ../shared/catalog/acquisition.test.mjs ../shared/catalog/source-registry.test.mjs ../shared/contracts/device-pairing-v1.test.mjs ../shared/contracts/device-pairing-nip17.test.mjs ../shared/contracts/device-transfer-v1.test.mjs ../shared/torrent/metadata.test.mjs ../web/tests/book-rights-v2-contract.test.mjs ../web/tests/desktop-progress.test.mjs ../web/tests/reader-speech.test.mjs ../web/tests/reader-typography.test.mjs ../web/tests/speech-settings.test.mjs",
    "test:coverage": "node --max-old-space-size=768 --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude='**/*.test.js' --test-coverage-exclude='**/*.test.mjs' --test --test-reporter=tap tests/unit/*.test.js ../shared/catalog/acquisition.test.mjs ../shared/catalog/source-registry.test.mjs ../shared/contracts/device-pairing-v1.test.mjs ../shared/contracts/device-pairing-nip17.test.mjs ../shared/contracts/device-transfer-v1.test.mjs ../shared/torrent/metadata.test.mjs ../web/tests/book-rights-v2-contract.test.mjs ../web/tests/desktop-progress.test.mjs ../web/tests/reader-speech.test.mjs ../web/tests/reader-typography.test.mjs ../web/tests/speech-settings.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:torrent": "node --test tests/e2e/webtorrent-private.e2e.test.js",
    "test:e2e:docker": "docker build --file Dockerfile.test --tag bookstr-electron-tests .. && docker run --rm --init --ipc=host bookstr-electron-tests",
    "test:e2e:smoke": "playwright test tests/e2e/desktop.smoke.spec.js",
    "test:e2e:transfers": "playwright test tests/e2e/desktop.device-transfer.spec.js",
    "test:e2e:reader": "playwright test tests/e2e/desktop.reader.spec.js",
    "test:e2e:headed": "playwright test --headed",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.bookstr.desktop",
    "productName": "libstr",
    "beforePack": "./stamp-build.js",
    "icon": "assets/icon-macos.png",
    "files": [
      "package.json",
      {
        "from": ".",
        "to": "desktop",
        "filter": [
          "assets/icon-macos.png",
          "catalog-proxy.js",
          "dictionary-proxy.js",
          "webtorrent-bridge.js",
          "device-pairing.js",
          "library-store.js",
          "library-downloads.js",
          "library-import.js",
          "library-cover.js",
          "acquisition-manager.js",
          "download-queue.js",
          "kindle-sync.js",
          "kindle-mtp.js",
          "mtp-session.js",
          "comic-pdf.js",
          "comic-image.js",
          "main.js",
          "build-info.json",
          "preload.js",
          "security-policy.js",
          "speech-model-store.js",
          "package.json",
          "catalog-invitations.js"
        ]
      },
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*",
          "!tests/**/*"
        ]
      },
      {
        "from": "../shared",
        "to": "shared",
        "filter": [
          "catalog/acquisition.mjs",
          "catalog/source-registry.mjs",
          "rights/rights.mjs",
          "contracts/device-pairing-client.mjs",
          "contracts/device-pairing-v1.mjs",
          "contracts/device-pairing-nip17.mjs",
          "contracts/device-registry-nip78.mjs",
          "contracts/device-transfer-v1.mjs"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "native",
        "to": ".",
        "filter": [
          "kindle-mtp",
          "kindle-wpd.ps1",
          "lib/**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/7zip-bin-full/**/*"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "assets/icon-macos.png",
      "artifactName": "libstr-desktop-${version}-${os}-${arch}.dmg",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon-macos.png",
      "artifactName": "libstr-desktop-${version}-setup-${arch}.exe",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon-macos.png",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "app.bookstr.desktop"
        }
      },
      "artifactName": "libstr-desktop-${version}-${arch}.AppImage",
      "category": "Office",
      "maintainer": "libstr <support@bookstr.dev>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "protocols": [
      {
        "name": "Bookstr",
        "schemes": [
          "bookstr"
        ]
      }
    ]
  },
  "dependencies": {
    "7zip-bin-full": "^26.3.1",
    "bmp-js": "^0.1.0",
    "nostr-tools": "^2.25.0",
    "omggif": "^1.0.10",
    "pdfkit": "^0.17.2",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "webtorrent": "^3.0.21"
  },
  "optionalDependencies": {
    "@roamhq/wrtc": "^0.10.0"
  },
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.12.0"
  }
}
