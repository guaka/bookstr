FROM node:26.13.0-bookworm-slim AS node-runtime

FROM mcr.microsoft.com/playwright:v1.62.1-noble

# Keep Playwright's browser dependencies while using the repository's Node 26 runtime.
COPY --from=node-runtime /usr/local/bin/node /usr/bin/node
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential libatomic1 python3 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/desktop

COPY --chown=pwuser:pwuser desktop/package.json desktop/pnpm-lock.yaml desktop/pnpm-workspace.yaml ./
COPY --chown=pwuser:pwuser desktop/patches/ ./patches/
RUN chown -R pwuser:pwuser /workspace

RUN npm install --global pnpm@10.34.8
ENV MAKEFLAGS=-j2
USER pwuser
RUN pnpm install --frozen-lockfile

COPY --chown=pwuser:pwuser desktop/ ./
COPY --chown=pwuser:pwuser shared/ ../shared/
COPY --chown=pwuser:pwuser web/ ../web/

ENV CI=1

ENTRYPOINT ["xvfb-run", "-a"]
CMD ["pnpm", "run", "test:e2e"]
