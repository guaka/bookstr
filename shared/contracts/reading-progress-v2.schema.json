{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookstr.app/contracts/reading-progress-v2.schema.json",
  "title": "Bookstr reading progress compatibility cases v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": 2 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "content", "fallbackBookId", "eventCreatedAt", "valid"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "content": {},
        "fallbackBookId": { "type": "string" },
        "eventCreatedAt": { "type": "integer" },
        "valid": { "type": "boolean" },
        "expected": {
          "type": "object",
          "required": ["bookId", "progression", "furthestProgression", "cfi", "updatedAt"],
          "properties": {
            "bookId": { "type": "string" },
            "progression": { "type": "number" },
            "furthestProgression": { "type": "number" },
            "cfi": { "type": "string" },
            "updatedAt": { "type": "integer" }
          }
        }
      }
    }
  }
}
