{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookstr.app/contracts/vocabulary-wire-v1.schema.json",
  "title": "Bookstr vocabulary wire compatibility cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fields", "cases"],
  "properties": {
    "version": { "const": 1 },
    "fields": { "type": "object" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "payload", "fallbackUpdatedAt", "valid"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "payload": { "type": "object" },
        "fallbackUpdatedAt": { "type": "integer" },
        "valid": { "type": "boolean" },
        "expected": { "type": "object" }
      }
    }
  }
}
