{
  "extends": "../../web/tsconfig.tools.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": ".",
    "noEmit": false,
    "declaration": true,
    "allowImportingTsExtensions": false,
    "typeRoots": [
      "../../web/node_modules/@types"
    ]
  },
  "include": [
    "src/**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
