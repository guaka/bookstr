{
  "name": "bookstr-static-web",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": { "node": ">=26.13.0" },
  "scripts": {
    "typecheck": "node --max-old-space-size=512 scripts/typescript.cts --noEmit",
    "typecheck:worker": "node --max-old-space-size=512 node_modules/typescript/bin/tsc -p ../worker/tsconfig.json",
    "build": "node --max-old-space-size=512 scripts/typescript.cts",
    "build:site": "node --max-old-space-size=512 scripts/typescript.cts --site",
    "check:generated": "node --max-old-space-size=512 scripts/typescript.cts --check",
    "sync:vendor": "node --max-old-space-size=512 scripts/vendor.cts",
    "check:vendor": "node --max-old-space-size=512 scripts/vendor.cts --check",
    "test": "node --max-old-space-size=768 --test-concurrency=1 --test tests/*.test.mjs tests/*.test.mts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "c8": "12.0.0",
    "epubjs": "0.3.93",
    "esbuild": "0.28.2",
    "jszip": "3.10.1",
    "libarchive-wasm": "1.2.0",
    "nostr-tools": "2.24.1",
    "pdfjs-dist": "6.2.108",
    "sql.js": "1.13.0",
    "typescript": "7.0.2"
  }
}
